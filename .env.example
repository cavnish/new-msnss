# =============================================================================
# MSNSS – M S HVAC Engineers · Environment Variables
# Copy to .env.local (local) or set in your host dashboard (Hostinger / Render).
#
# ⚠ This file is a TEMPLATE and is committed. Never put a real password, API key
# or AUTH_SECRET here — `.env.local` is git-ignored and is the only place real
# values belong. Variables marked SERVER ONLY must never be exposed to the
# browser and must NOT be prefixed with NEXT_PUBLIC_.
#
# Verify nothing leaks to the browser after changing these:
#   npm run check:secrets       static scan of the build output
#   npm run check:secrets:live  scan of what an anonymous visitor receives
# =============================================================================

# --- Database (SERVER ONLY, REQUIRED) ---------------------------------------
# PostgreSQL connection string used by Drizzle ORM.
# Neon: Dashboard → Connection Details → Pooled connection.
#   - Use the POOLED (-pooler) host, not the direct one, for serverless.
#   - Keep `sslmode=require` and `channel_binding=require`.
#   - URL-encode any special characters in the password.
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL=

# --- Admin auth secret (SERVER ONLY, REQUIRED IN PRODUCTION) ----------------
# Signs admin JWT session cookies. Must be a long random string (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app will REFUSE to start admin auth in production if this is missing.
AUTH_SECRET=

# --- Public site URL (CLIENT + SERVER, REQUIRED) ----------------------------
# Canonical production URL. Used for canonical tags, sitemap, OG URLs and the
# "view inquiry" link inside owner emails. No trailing slash.
# Example: https://www.msnss.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend email (SERVER ONLY, REQUIRED for email notifications) -----------
# Get a restricted API key at https://resend.com after verifying your domain.
# If unset, inquiries are still SAVED but no email is sent (fail-safe).
RESEND_API_KEY=
# Verified sender. Example: "MSNSS <sales@msnss.com>"
MAIL_FROM=
# Where new-inquiry notifications are delivered. Example: sales@msnss.com
OWNER_EMAIL=

# --- Supabase Storage (SERVER ONLY service role; RECOMMENDED for production) -
# Required for reliable media on Render (ephemeral filesystem) and recommended
# on Hostinger. If unset, the app falls back to local disk uploads (dev only).
# Supabase: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY — full storage admin rights. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe values for client-side media helpers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudinary media (SERVER ONLY; RECOMMENDED for all website images) ------
# Cloudinary is the central image system. API secret is NEVER exposed to the
# browser. When these are empty the site still works using local/Supabase media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Client-visible cloud name for browser-side optimized URL building.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
